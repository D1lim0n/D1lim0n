local function makeToggle(parent, x, y, w, h, state, onToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, w, 0, h)
    btn.Position = UDim2.new(0, x, 0, y)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 9
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    local s = state
    local function update()
        btn.BackgroundColor3 = s and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
        btn.Text = s and "ON" or "OFF"
    end
    update()
    btn.MouseButton1Click:Connect(function()
        s = not s
        update()
        onToggle(s)
    end)
    return btn, function() return s end, function(ns) s = ns; update() end
end

