local function togglePanel()
    expanded = not expanded
    arrow.Text = expanded and "\u{25BE}" or "\u{25B8}"
    if expanded then
        panel.Visible = true
        panel.Size = UDim2.new(0, 230, 0, 0)
        local tween = TweenService:Create(panel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 230, 0, 140)})
        tween:Play()
    else
        local tween = TweenService:Create(panel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 230, 0, 0)})
        tween:Play()
        tween.Completed:Connect(function()
            if not expanded then
                panel.Visible = false
            end
        end)
    end
end

bar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        barDragging = true
        barDragStart = input.Position
        barStartPos = bar.Position
        barMoved = false
    end
end)

track(UserInputService.InputChanged:Connect(function(input)
    if barDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - barDragStart
        if delta.Magnitude > 3 then
            barMoved = true
        end
        if barMoved then
            local newX = math.clamp(barStartPos.X.Offset + delta.X, 0, Camera.ViewportSize.X - bar.AbsoluteSize.X)
            local newY = math.clamp(barStartPos.Y.Offset + delta.Y, 0, Camera.ViewportSize.Y - bar.AbsoluteSize.Y)
            bar.Position = UDim2.new(0, newX, 0, newY)
            panel.Position = UDim2.new(0, newX, 0, newY + 28)
        end
    end
end))

